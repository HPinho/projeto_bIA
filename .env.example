# DEV ONLY: use separate keys for anotação e revisão; never commit credentials
BIA_DATABASE_URL=sqlite:///./data/bia.sqlite3
BIA_STORAGE_DIR=./data/documents
BIA_API_KEYS={"local-admin-change-me":{"actor":"admin-local","role":"admin"},"local-reviewer-change-me":{"actor":"reviewer-local","role":"curator","institutes":["inovaligno"]}}
BIA_MAX_PDF_BYTES=20971520
# BIA_MODEL_DIR=./checkpoints/run-2026-10-21
# Set to 0 after running `python -m bia_core.schema` explicitly before production startup
BIA_AUTO_MIGRATE=1
# Optional per-actor authorized institutes: "institutes": ["inovaligno", "polissacarideos", "circularidade"]

# Teste PostgreSQL CI (use somente banco descartável):
# BIA_TEST_POSTGRES_URL=postgresql+psycopg://bia:temporary@localhost:5432/bia_test
# Controle de retenção: somente administrações autenticadas; sem deleção automática.

# BIA-02.8: documentos institucionais exigem institute=... na importação.
# Documentos institucionais anteriores sem afiliação são visíveis somente ao administrador;
# atribuir via PUT /v1/documents/{id}/institution e registrar justificativa.
# Tokens são credenciais de protótipo: usar segredos aleatórios e HTTPS antes de rede externa.
